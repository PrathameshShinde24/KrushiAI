# Copy this file to .env and fill in your values. Never commit .env.

# Required — MongoDB Atlas connection string (Atlas → Connect → Drivers)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?appName=KrushiAI
MONGODB_DB=krushiai

# Optional — Weather page (openweathermap.org)
OPENWEATHER_API_KEY=

# Optional — Agri Hub news (newsapi.org)
NEWS_API_KEY=

# Optional — direct or Google Drive link to pomegranate_model.h5,
# downloaded on first run if models/pomegranate_model.h5 is missing
MODEL_URL=
